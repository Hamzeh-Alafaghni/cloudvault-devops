# =============================================================================
# CloudVault — example environment file
# =============================================================================
# Copy this to `.env` (which is git-ignored) before running `make up`.
#   cp .env.example .env
# The defaults below work out-of-the-box for local Docker Compose.
# NEVER commit a real .env. NEVER put real cloud credentials here.
# =============================================================================

# ---- JWT (shared secret used by gateway + auth-service) ----
# Change this to a long random string for anything beyond local dev.
JWT_SECRET=dev-super-secret-change-me
JWT_EXPIRES_IN=2h

# ---- Auth service DB (Postgres: auth-db) ----
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=authpass
AUTH_DB_NAME=authdb

# ---- Files service DB (Postgres: files-db) ----
FILES_DB_HOST=files-db
FILES_DB_PORT=5432
FILES_DB_USER=files
FILES_DB_PASSWORD=filespass
FILES_DB_NAME=filesdb

# ---- Notification service (reuses files-db instance, own database) ----
NOTIF_DB_HOST=files-db
NOTIF_DB_PORT=5432
NOTIF_DB_USER=files
NOTIF_DB_PASSWORD=filespass
NOTIF_DB_NAME=notifdb

# ---- Redis (event broker; Redis Streams) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAM=cloudvault:events

# ---- S3 / LocalStack ----
# Inside the Docker network, services reach LocalStack at localstack:4566.
# Presigned download URLs must be usable by the BROWSER, so they are signed
# against the public endpoint (localhost:4566).
S3_ENDPOINT=http://localstack:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=cloudvault
S3_FORCE_PATH_STYLE=true
# LocalStack accepts any credentials; these are throwaway test values.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ---- Internal service URLs (Docker network DNS names) ----
AUTH_SERVICE_URL=http://auth-service:3001
FILES_SERVICE_URL=http://files-service:3002
UPLOAD_SERVICE_URL=http://upload-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3004

# ---- Gateway ----
GATEWAY_PORT=8080

# ---- Web (Vite) ----
# Base URL the browser uses to reach the gateway.
VITE_API_BASE=http://localhost:8080
